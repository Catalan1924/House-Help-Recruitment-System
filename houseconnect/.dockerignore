# ============================================================
# HouseConnect Kenya — Docker Ignore
# ============================================================
# Keeps the Docker build context small and secure.
# ============================================================

# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS generated
Thumbs.db
ehthumbs.db
Desktop.ini

# Testing
coverage/
.nyc_output/
*.test.js
*.spec.js
__tests__/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Git
.git/
.gitattributes
.gitignore

# Documentation
*.md
!README.md

# Temporary
tmp/
temp/
*.tmp

# Screenshots & artifacts
*.png
*.jpg
*.jpeg
!public/*.png
!public/*.jpg

# Supabase (handled separately)
supabase/.branches/
supabase/.temp/

# CI/CD
.github/
